    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.17",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.7",
    "@types/pg": "^8.23.1",
